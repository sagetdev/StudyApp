# PostgreSQL connection string (use your provider's pooled URL if required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate a long random secret for signing JWTs; never commit your real secret.
JWT_SECRET="replace-with-a-long-random-secret"

# Google AI key used by the AI study-pack endpoint
GOOGLE_API_KEY="replace-with-your-google-ai-key"

PORT=4000
